{
  "name": "@vite-plugin-uni-pages/monorepo",
  "type": "module",
  "version": "0.5.0",
  "private": true,
  "packageManager": "pnpm@12.14.0",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26",
      "onFail": "warn"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "12.14.0",
      "onFail": "warn"
    }
  },
  "description": "Use TypeScript to write pages.json of uni-app",
  "author": "KeJun",
  "license": "MIT",
  "homepage": "https://github.com/uni-helper/vite-plugin-uni-pages#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/uni-helper/vite-plugin-uni-pages.git"
  },
  "bugs": "https://github.com/uni-helper/vite-plugin-uni-pages/issues",
  "keywords": [],
  "sideEffects": false,
  "scripts": {
    "build": "rimraf --glob 'packages/*/dist' && pnpm -r --filter='./packages/*' run build && pnpm -r run build-post",
    "build:mp-alipay": "pnpm -C playground run build:mp-alipay",
    "build:mp-weixin": "pnpm -C playground run build:mp-weixin",
    "build:web": "pnpm -C playground run build:web",
    "coverage": "vitest run --coverage",
    "dev": "pnpm -r --filter='./packages/*' --parallel run dev",
    "docs:build": "pnpm -C docs run build",
    "docs:dev": "pnpm -C docs run dev",
    "docs:preview": "pnpm -C docs run preview",
    "lint": "eslint .",
    "lint:fix": "pnpm lint --fix",
    "play:mp-alipay": "pnpm -C playground run dev:mp-alipay",
    "play:mp-weixin": "pnpm -C playground run dev:mp-weixin",
    "play:web": "pnpm -C playground run dev:web",
    "prepublishOnly": "pnpm build",
    "release": "bumpp",
    "test": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@antfu/eslint-config": "catalog:",
    "@types/node": "catalog:",
    "bumpp": "catalog:",
    "comment-json": "catalog:",
    "eslint": "catalog:",
    "rimraf": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "unrun": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
